# Public (shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Supabase Dashboard -> Connect -> Transaction pooler (port 6543).
# Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_DB_URL=postgres://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional: DB pool size per serverless instance (default 4)
# DB_POOL_MAX=4

# SUPABASE_SERVICE_ROLE_KEY is NOT required: all privileged work goes through SUPABASE_DB_URL.
